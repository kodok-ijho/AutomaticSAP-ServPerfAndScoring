# ==============================================================================
# SAP AUTOMATION & SERVICE PERFORMANCE SCORING - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Petunjuk: Salin file ini menjadi `.env` di direktori yang sama dan isi nilai yang sesuai.
# JANGAN PERNAH meng-commit file `.env` yang berisi password ke repositori Git.

# ------------------------------------------------------------------------------
# 1. SAP Logon Credentials & Target Connection
# ------------------------------------------------------------------------------
# Username akun SAP Anda (misal: 2436dyu)
SAP_USERNAME=your_sap_username

# Password akun SAP Anda
SAP_PASSWORD=your_sap_password

# Nama deskripsi koneksi SAP di SAP Logon Pad (misal: SAP HANA AGDS PROD)
SAP_CONNECTION=SAP HANA AGDS PROD

# ------------------------------------------------------------------------------
# 2. Database Connection (Microsoft SQL Server)
# ------------------------------------------------------------------------------
# IP Server atau Hostname Database SQL Server
DB_SERVER=172.31.151.88

# Nama Database tujuan (misal: DesSy)
DB_NAME=DesSy

# Username login SQL Server (SQL Authentication)
DB_USER=your_db_username

# Password login SQL Server
DB_PASSWORD=your_db_password

# Driver ODBC SQL Server yang terinstall di Windows
DB_DRIVER=ODBC Driver 17 for SQL Server
